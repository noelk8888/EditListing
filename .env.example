# Google OAuth (for user login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Sheets API (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=1T-LUc3cKn0ojq1p3VvgpFs4NzB8Z6ZKV4iJaoEhfwKM

# Claude API
ANTHROPIC_API_KEY=sk-ant-your_key_here

# NextAuth
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
# Shared by protected Vercel cron endpoints. Use a long random value in production.
CRON_SECRET=replace-with-a-long-random-value

# User Roles — comma-separated Google emails granted SUPERADMIN access
# These users bypass the app_users table and always have full access
SUPERADMIN_EMAILS=your_email@gmail.com

# Optional: Google Geocoding API (for lat/long)
GOOGLE_GEOCODING_API_KEY=your_geocoding_api_key

# Optional: Telegram notifications (send col A text on listing save/update)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_or_group_id

# Optional: Forward manual posts from LISTING UPDATES to PENDING LISTINGS.
# Do not enable these until @LuxeRealtyListingUpdateBot is an admin in both groups.
TELEGRAM_FORWARD_SOURCE_CHAT_ID=-1003879283490
TELEGRAM_FORWARD_DESTINATION_CHAT_ID=-1004488382171
TELEGRAM_FORWARD_EXCLUDED_USERNAME=LuxeRealtyListingUpdateBot

# Telegram Batch Update Lite queue (tab identified by gid)
TELEGRAM_BATCH_QUEUE_SPREADSHEET_ID=12Z8X3RmYRBMiihsxf-J0f650Ifj2irxRQsYC64Cgbw0
TELEGRAM_BATCH_QUEUE_SHEET_GID=873778190
# Optional but recommended: also pass this as secret_token when setting the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value

# The bot listens for your 👍 reaction in PENDING LISTINGS, then deletes the
# forwarded listing and its paired UPDATE message 15 minutes later.
# The group owner is verified through Telegram automatically; no user ID is needed.
